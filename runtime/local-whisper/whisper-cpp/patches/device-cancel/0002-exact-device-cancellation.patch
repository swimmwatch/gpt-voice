+bool whisper_local_get_device_evidence(
+        struct whisper_context * ctx,
+        struct whisper_local_device_evidence * evidence) {
+    if (ctx == nullptr || evidence == nullptr || ctx->state == nullptr ||
+        ctx->params.local_whisper_selected_device == nullptr || ctx->state->backends.empty()) {
+        return false;
+    }
+    ggml_backend_dev_t selected = (ggml_backend_dev_t) ctx->params.local_whisper_selected_device;
+    ggml_backend_dev_props selected_props{};
+    ggml_backend_dev_get_props(selected, &selected_props);
+    if (selected_props.device_id == nullptr) {
+        return false;
+    }
+
+    uint64_t weight_bytes = 0;
+    bool single_gpu_owner = true;
+    for (ggml_backend_buffer_t buffer : ctx->model.buffers) {
+        ggml_backend_dev_t owner = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buffer));
+        if (owner == nullptr) {
+            continue;
+        }
+        const auto type = ggml_backend_dev_type(owner);
+        if (type != GGML_BACKEND_DEVICE_TYPE_GPU && type != GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            continue;
+        }
+        if (owner != selected) {
+            single_gpu_owner = false;
+            continue;
+        }
+        const size_t bytes = ggml_backend_buffer_get_size(buffer);
+        if (bytes > UINT64_MAX - weight_bytes) {
+            return false;
+        }
+        weight_bytes += bytes;
+    }
+
+    ggml_backend_dev_t primary = ggml_backend_get_device(ctx->state->backends[0]);
+    if (primary == nullptr) {
+        return false;
+    }
+    ggml_backend_dev_props primary_props{};
+    ggml_backend_dev_get_props(primary, &primary_props);
+    if (primary_props.device_id == nullptr) {
+        return false;
+    }
+    evidence->activated_device_id = selected_props.device_id;
+    evidence->primary_state_device_id = primary_props.device_id;
+    evidence->model_weight_bytes = weight_bytes;
+    evidence->single_gpu_model_owner = single_gpu_owner;
+    return true;
+}
+
+bool whisper_local_set_abort_callback(
+        struct whisper_context * ctx,
+        ggml_abort_callback abort_callback,
+        void * abort_callback_user_data) {
+    if (ctx == nullptr || ctx->state == nullptr) {
+        return false;
+    }
+    for (ggml_backend_t backend : ctx->state->backends) {
+        ggml_backend_dev_t device = ggml_backend_get_device(backend);
+        ggml_backend_reg_t registry = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+        auto * set_abort_callback = registry
+            ? (ggml_backend_set_abort_callback_t) ggml_backend_reg_get_proc_address(
+                registry, "ggml_backend_set_abort_callback")
+            : nullptr;
+        if (set_abort_callback == nullptr) {
+            continue;
+        }
+        set_abort_callback(backend, abort_callback, abort_callback_user_data);
+    }
+    return true;
+}
