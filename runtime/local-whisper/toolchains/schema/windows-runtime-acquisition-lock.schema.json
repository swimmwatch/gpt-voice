{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/schemas/local-whisper-windows-runtime-acquisition-lock-v1.json",
  "title": "Local Whisper Windows runtime acquisition lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "lockId", "target", "installer", "installedRuntime", "materialization", "license"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaId": { "const": "local-whisper-windows-runtime-acquisition-lock-v1" },
    "lockId": { "$ref": "#/$defs/safeId" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "const": "windows" },
        "architecture": { "const": "x64" }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sizeBytes",
        "sha256",
        "fileVersion",
        "productVersion",
        "originalFilename",
        "targetArchitecture",
        "bootstrapMachine",
        "authenticodeStatus",
        "publisherSubject"
      ],
      "properties": {
        "url": {
          "const": "https://aka.ms/vs/18/release/14.51.36247/VC_redist.x64.exe"
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fileVersion": { "const": "14.51.36247.0" },
        "productVersion": { "const": "14.51.36247.0" },
        "originalFilename": { "const": "VC_redist.x64.exe" },
        "targetArchitecture": { "const": "x64" },
        "bootstrapMachine": { "const": "x86" },
        "authenticodeStatus": { "const": "Valid" },
        "publisherSubject": { "const": "CN=Microsoft Corporation" }
      }
    },
    "installedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryHive", "registryView", "registryKey", "installedValue", "versionValue", "version"],
      "properties": {
        "registryHive": { "const": "HKEY_LOCAL_MACHINE" },
        "registryView": { "const": "Registry64" },
        "registryKey": { "const": "SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64" },
        "installedValue": { "const": "Installed" },
        "versionValue": { "const": "Version" },
        "version": { "const": "v14.51.36247.00" }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "relativeDestination", "manifestName", "dllAllowlist"],
      "properties": {
        "source": { "const": "native-system32" },
        "relativeDestination": { "const": "vc-runtime-14.51.36247.0-x64" },
        "manifestName": { "const": "materialization-manifest.json" },
        "dllAllowlist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sizeBytes", "sha256", "fileVersion", "productVersion"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]+\\.dll$" },
              "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "fileVersion": { "const": "14.51.36247.0" },
              "productVersion": { "const": "14.51.36247.0" }
            }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "pathKind", "path", "sizeBytes", "sha256"],
      "properties": {
        "url": { "const": "https://visualstudio.microsoft.com/license-terms/vs2026-ga-visualcpp-v14-redist-runtime/" },
        "pathKind": { "const": "toolchainRootRelative" },
        "path": { "const": "licenses/visual-cpp-v14-runtime.html" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
