{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-whisper-worker-tsan-profile-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "baseToolchainProfile", "cmakeCache", "profileId", "proof", "schemaId", "suite", "target"],
  "properties": {
    "$schema": { "const": "schema/worker-tsan-profile.schema.json" },
    "schemaId": { "const": "local-whisper-worker-tsan-profile-v1" },
    "profileId": { "const": "linux-x64-clang-18.1.3-tsan-v1" },
    "baseToolchainProfile": { "const": "linux-x64-clang-18.1.3-asan-ubsan-v1" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "os"],
      "properties": {
        "architecture": { "const": "x64" },
        "os": { "const": "linux" }
      }
    },
    "cmakeCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["LOCAL_WHISPER_ENABLE_SANITIZERS", "LOCAL_WHISPER_ENABLE_THREAD_SANITIZER"],
      "properties": {
        "LOCAL_WHISPER_ENABLE_SANITIZERS": { "const": "OFF" },
        "LOCAL_WHISPER_ENABLE_THREAD_SANITIZER": { "const": "ON" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "expectedClassification", "timeoutMilliseconds"],
      "properties": {
        "executable": { "const": "local_whisper_worker_tsan_race_proof" },
        "expectedClassification": { "const": "data-race" },
        "timeoutMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 60000 }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredTests", "testPattern", "timeoutMilliseconds"],
      "properties": {
        "testPattern": { "const": "^WorkerApplication\\." },
        "timeoutMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "requiredTests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^WorkerApplication\\." }
        }
      }
    }
  }
}
