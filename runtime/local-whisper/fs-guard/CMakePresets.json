{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux production guard",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../.cache/local-whisper/fs-guard/build-linux-release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-test",
      "displayName": "Linux Clang sanitized native tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../.cache/local-whisper/fs-guard/build-linux-test",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "FS_GUARD_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-gcc-test",
      "displayName": "Linux GCC 13 native tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../.cache/local-whisper/fs-guard/build-linux-gcc-test",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "FS_GUARD_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC 13 production guard",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../.cache/local-whisper/fs-guard/build-linux-gcc-release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows production guard",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../.cache/local-whisper/fs-guard/build-windows-release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-test",
      "displayName": "Windows MSVC native tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../.cache/local-whisper/fs-guard/build-windows-test",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows MSVC AddressSanitizer native tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../.cache/local-whisper/fs-guard/build-windows-asan",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "FS_GUARD_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-test",
      "configurePreset": "linux-test"
    },
    {
      "name": "linux-gcc-test",
      "configurePreset": "linux-gcc-test"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-test",
      "configurePreset": "windows-test"
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan"
    }
  ],
  "testPresets": [
    {
      "name": "linux-unit",
      "configurePreset": "linux-test",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "linux-integration",
      "configurePreset": "linux-test",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "integration" } }
    },
    {
      "name": "linux-gcc-unit",
      "configurePreset": "linux-gcc-test",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "linux-gcc-integration",
      "configurePreset": "linux-gcc-test",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "integration" } }
    },
    {
      "name": "windows-unit",
      "configurePreset": "windows-test",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "windows-integration",
      "configurePreset": "windows-test",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "integration" } }
    },
    {
      "name": "windows-asan-unit",
      "configurePreset": "windows-asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "windows-asan-integration",
      "configurePreset": "windows-asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "integration" } }
    }
  ]
}
