{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/local-whisper/qualification/evidence-index-v2.schema.json",
  "title": "Local Whisper immutable platform evidence index v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specificationRevision",
    "indexDigest",
    "candidateInputDigest",
    "platformGraphDigest",
    "platformResultDigest",
    "platform",
    "fixtureDigest",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "specificationRevision": { "const": 10 },
    "indexDigest": { "$ref": "#/$defs/sha256" },
    "candidateInputDigest": { "$ref": "#/$defs/sha256" },
    "platformGraphDigest": { "$ref": "#/$defs/sha256" },
    "platformResultDigest": { "$ref": "#/$defs/sha256" },
    "platform": { "enum": ["linux", "win32"] },
    "fixtureDigest": {
      "const": "de8603f4c96a793ed3a3d3a03941f44d67592ae945d17d3b19ae0ed56e039226"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "evidenceClass", "sha256", "byteLength", "sanitizedLabel"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "platform": { "enum": ["linux", "win32", "shared"] },
          "evidenceClass": {
            "enum": ["deterministic", "source", "native", "platform", "hardware", "package", "manual", "transport"]
          },
          "sha256": { "$ref": "#/$defs/sha256" },
          "byteLength": { "type": "integer", "minimum": 1 },
          "sanitizedLabel": { "$ref": "#/$defs/label" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f/\\\\]+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
