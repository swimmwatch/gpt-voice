{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/local-whisper/qualification/performance-manifest-v1.schema.json",
  "title": "Local Whisper performance qualification manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractRevision",
    "performanceManifestDigest",
    "sourceRevision",
    "platform",
    "architecture",
    "backend",
    "executionMode",
    "evidenceClaim",
    "inputFixtureDigest",
    "modelArtifacts",
    "cacheStates",
    "candidateWindows",
    "minimumSuccessfulPairs",
    "plannedPairsPerCandidateCacheState",
    "runOrdering",
    "statistic",
    "uncertaintyMethod",
    "samplingIntervalMilliseconds",
    "units",
    "requiredPhaseIds",
    "requiredResourceIds",
    "sourceHashBaseline"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractRevision": { "const": 1 },
    "performanceManifestDigest": { "$ref": "#/$defs/sha256" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "platform": { "enum": ["linux", "win32"] },
    "architecture": { "const": "x64" },
    "backend": { "enum": ["cpu", "cuda"] },
    "executionMode": { "enum": ["hostedFixture", "representativeHost"] },
    "evidenceClaim": { "enum": ["contractOnly", "representativePerformance"] },
    "inputFixtureDigest": { "$ref": "#/$defs/sha256" },
    "modelArtifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "variant", "sha256"],
        "properties": {
          "family": { "enum": ["base", "medium", "large-v3"] },
          "variant": { "enum": ["full", "q5_0"] },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "cacheStates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["cold", "warm"] }
    },
    "candidateWindows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": [1, 2, 4, 8] }
    },
    "minimumSuccessfulPairs": { "const": 5 },
    "plannedPairsPerCandidateCacheState": { "type": "integer", "minimum": 5, "maximum": 64 },
    "runOrdering": { "const": "alternatingBeforeAfter" },
    "statistic": { "const": "medianOfPairedPercentages" },
    "uncertaintyMethod": { "const": "medianAbsoluteDeviation" },
    "samplingIntervalMilliseconds": { "type": "integer", "minimum": 10, "maximum": 1000 },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phaseDuration", "resourcePeak", "change"],
      "properties": {
        "phaseDuration": { "const": "nanoseconds" },
        "resourcePeak": { "const": "bytes" },
        "change": { "const": "percent" }
      }
    },
    "requiredPhaseIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 19,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/phaseId" }
    },
    "requiredResourceIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resourceId" }
    },
    "sourceHashBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeOptimization", "afterDirectoryReuse"],
      "properties": {
        "beforeOptimization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "win32"],
          "properties": {
            "linux": { "const": 8 },
            "win32": { "const": 7 }
          }
        },
        "afterDirectoryReuse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "win32"],
          "properties": {
            "linux": { "const": 7 },
            "win32": { "const": 6 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "phaseId": {
      "enum": [
        "directoryProofRuntimeAcquisition",
        "directoryProofModelAcquisition",
        "directoryProofRuntimePreSpawn",
        "directoryProofModelPreSpawn",
        "directoryProofModelPreLoad",
        "nativeModelGuardDigest",
        "nativeAuthorityDigest",
        "workerPreflightDigest",
        "workerLoaderDigest",
        "guardedProcessCreation",
        "authorityTransfer",
        "modelPreflight",
        "whisperLoad",
        "inferenceWarmup",
        "gpuUploadAllocation",
        "installationEncode",
        "installationPipeWait",
        "installationDecode",
        "installationWrite"
      ]
    },
    "resourceId": {
      "enum": ["mainProcessPeakRss", "guardProcessPeakRss", "workerProcessPeakRss", "gpuPeakVram"]
    }
  }
}
