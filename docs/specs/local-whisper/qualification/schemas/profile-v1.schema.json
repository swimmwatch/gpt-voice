{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/local-whisper/qualification/profile-v1.schema.json",
  "title": "Local Whisper qualification profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileDigest",
    "profileId",
    "platform",
    "architecture",
    "backend",
    "engine",
    "runtimeRevision",
    "modelRevision",
    "fixtureDigests",
    "repetitions",
    "warmupRuns",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileDigest": { "$ref": "#/$defs/sha256" },
    "profileId": { "$ref": "#/$defs/identifier" },
    "platform": { "enum": ["linux", "win32"] },
    "architecture": { "const": "x64" },
    "backend": { "enum": ["cpu", "cuda"] },
    "engine": { "const": "whisperCpp" },
    "runtimeRevision": { "$ref": "#/$defs/identifier" },
    "modelRevision": { "$ref": "#/$defs/identifier" },
    "fixtureDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "repetitions": { "type": "integer", "minimum": 5, "maximum": 100 },
    "warmupRuns": { "type": "integer", "minimum": 1, "maximum": 20 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumRtf",
        "maximumWerDeltaPercentagePoints",
        "maximumRamBytes",
        "maximumVramBytes",
        "loadUnloadCycles",
        "sequentialTranscriptions",
        "settlingMilliseconds"
      ],
      "properties": {
        "maximumRtf": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "maximumWerDeltaPercentagePoints": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumRamBytes": { "type": "integer", "minimum": 1 },
        "maximumVramBytes": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "notApplicable" }] },
        "loadUnloadCycles": { "type": "integer", "minimum": 10 },
        "sequentialTranscriptions": { "type": "integer", "minimum": 20 },
        "settlingMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
