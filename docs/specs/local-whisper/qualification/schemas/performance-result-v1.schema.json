{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/local-whisper/qualification/performance-result-v1.schema.json",
  "title": "Local Whisper performance qualification result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractRevision",
    "performanceResultDigest",
    "performanceManifestDigest",
    "platform",
    "backend",
    "executionMode",
    "evidenceClaim",
    "sampleDigests",
    "failedSamples",
    "candidateResults",
    "selectedInFlightWindow",
    "selectionStatus",
    "sourceHashBaseline"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractRevision": { "const": 1 },
    "performanceResultDigest": { "$ref": "#/$defs/sha256" },
    "performanceManifestDigest": { "$ref": "#/$defs/sha256" },
    "platform": { "enum": ["linux", "win32"] },
    "backend": { "enum": ["cpu", "cuda"] },
    "executionMode": { "enum": ["hostedFixture", "representativeHost"] },
    "evidenceClaim": { "enum": ["contractOnly", "representativePerformance"] },
    "sampleDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "failedSamples": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sampleId", "reasonCode"],
        "properties": {
          "sampleId": { "$ref": "#/$defs/identifier" },
          "reasonCode": { "$ref": "#/$defs/reasonCode" }
        }
      }
    },
    "candidateResults": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/candidateResult" }
    },
    "selectedInFlightWindow": {
      "oneOf": [{ "enum": [1, 2, 4, 8] }, { "type": "null" }]
    },
    "selectionStatus": { "enum": ["fixtureOnly", "selected", "blocked"] },
    "sourceHashBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeOptimization", "afterDirectoryReuse"],
      "properties": {
        "beforeOptimization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "win32"],
          "properties": { "linux": { "const": 8 }, "win32": { "const": 7 } }
        },
        "afterDirectoryReuse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "win32"],
          "properties": { "linux": { "const": 7 }, "win32": { "const": 6 } }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointEstimatePercent", "uncertaintyPercent", "conservativePercent", "status"],
      "properties": {
        "pointEstimatePercent": { "type": "number" },
        "uncertaintyPercent": { "type": "number", "minimum": 0 },
        "conservativePercent": { "type": "number" },
        "status": { "enum": ["Pass", "Fail"] }
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pointEstimatePercent", "uncertaintyPercent", "upperBoundPercent", "status"],
      "properties": {
        "id": {
          "enum": ["endToEnd", "mainProcessPeakRss", "guardProcessPeakRss", "workerProcessPeakRss", "gpuPeakVram"]
        },
        "pointEstimatePercent": { "type": "number" },
        "uncertaintyPercent": { "type": "number", "minimum": 0 },
        "upperBoundPercent": { "type": "number" },
        "status": { "enum": ["Pass", "Fail"] }
      }
    },
    "candidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateWindow",
        "successfulPairsByCacheState",
        "targetedComponent",
        "guardrails",
        "status",
        "reasonCodes"
      ],
      "properties": {
        "candidateWindow": { "enum": [1, 2, 4, 8] },
        "successfulPairsByCacheState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cold", "warm"],
          "properties": {
            "cold": { "type": "integer", "minimum": 0, "maximum": 64 },
            "warm": { "type": "integer", "minimum": 0, "maximum": 64 }
          }
        },
        "targetedComponent": { "oneOf": [{ "$ref": "#/$defs/estimate" }, { "type": "null" }] },
        "guardrails": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/guardrail" }
        },
        "status": { "enum": ["Pass", "Fail"] },
        "reasonCodes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        }
      }
    }
  }
}
