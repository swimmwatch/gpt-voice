{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/local-whisper/qualification/focused-performance-run-plan-v4.schema.json",
  "title": "Local Whisper revision-7 focused candidate performance run plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractRevision",
    "focusedPerformanceRunPlanDigest",
    "sourceRevision",
    "sourceProofDigest",
    "candidateCommit",
    "platform",
    "architecture",
    "backend",
    "executionMode",
    "evidenceClaim",
    "candidateSource",
    "qualificationCache",
    "applicationArtifact",
    "runtimeArtifact",
    "model",
    "inputFixture",
    "cachePreparationProcedure",
    "cacheStates",
    "successfulSamplesPerCell",
    "runOrdering",
    "statistic",
    "fiveSecondObjectiveMilliseconds",
    "attemptTimeoutMilliseconds",
    "requiredPhaseIds",
    "requiredResourceIds",
    "sourceHashBaseline"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "contractRevision": { "const": 7 },
    "focusedPerformanceRunPlanDigest": { "$ref": "#/$defs/sha256" },
    "sourceRevision": { "$ref": "#/$defs/commit" },
    "sourceProofDigest": { "$ref": "#/$defs/sha256" },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "platform": { "const": "linux" },
    "architecture": { "const": "x64" },
    "backend": { "enum": ["cpu", "cuda"] },
    "executionMode": { "const": "representativeHost" },
    "evidenceClaim": { "const": "representativePerformance" },
    "candidateSource": { "$ref": "#/$defs/candidateSource" },
    "qualificationCache": { "$ref": "#/$defs/cache" },
    "applicationArtifact": { "$ref": "#/$defs/artifact" },
    "runtimeArtifact": { "$ref": "#/$defs/artifact" },
    "model": { "$ref": "#/$defs/modelWithArtifact" },
    "inputFixture": { "$ref": "#/$defs/artifact" },
    "cachePreparationProcedure": { "const": "linuxFileAdviceV1" },
    "cacheStates": { "const": ["cold", "warm"] },
    "successfulSamplesPerCell": { "const": 3 },
    "runOrdering": { "const": "coldThenWarm" },
    "statistic": { "const": "medianMinimumMaximum" },
    "fiveSecondObjectiveMilliseconds": { "const": 5000 },
    "attemptTimeoutMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
    "requiredPhaseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "requiredResourceIds": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
    "sourceHashBaseline": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.?(?:[/\\\\]|$))[A-Za-z0-9._/\\\\-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sizeBytes", "sha256"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "variant", "sizeBytes", "sha256"],
      "properties": {
        "family": { "const": "base" },
        "variant": { "const": "full" },
        "sizeBytes": { "const": 147951465 },
        "sha256": { "const": "60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe" }
      }
    },
    "modelWithArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "variant", "sizeBytes", "sha256", "artifact"],
      "properties": {
        "family": { "const": "base" },
        "variant": { "const": "full" },
        "sizeBytes": { "const": 147951465 },
        "sha256": { "const": "60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotDigest", "evidenceIdentityDigest", "entryCount", "fileCount", "sizeBytes"],
      "properties": {
        "snapshotDigest": { "$ref": "#/$defs/sha256" },
        "evidenceIdentityDigest": { "$ref": "#/$defs/sha256" },
        "entryCount": { "type": "integer", "minimum": 1 },
        "fileCount": { "type": "integer", "minimum": 1 },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "candidateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "commit",
        "sourceProofDigest",
        "instrumentationOverlaySha256",
        "derivedTreeManifestSha256",
        "executableArtifactSha256"
      ],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "commit": { "$ref": "#/$defs/commit" },
        "sourceProofDigest": { "$ref": "#/$defs/sha256" },
        "instrumentationOverlaySha256": { "$ref": "#/$defs/sha256" },
        "derivedTreeManifestSha256": { "$ref": "#/$defs/sha256" },
        "executableArtifactSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
