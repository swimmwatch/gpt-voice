{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/schemas/local-whisper-acceptance-owners-v2.json",
  "title": "Local Whisper automated acceptance ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specificationRevision",
    "planRevision",
    "taskFiles",
    "deferredTasks",
    "supersededTasks",
    "verificationCommands",
    "automatedAcceptanceOwners"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "specificationRevision": {
      "const": 25
    },
    "planRevision": {
      "const": 33
    },
    "taskFiles": {
      "type": "object",
      "minProperties": 36,
      "maxProperties": 36,
      "patternProperties": {
        "^(0[1-9]|[12][0-9]|3[0-6])$": {
          "type": "string",
          "pattern": "^(0[1-9]|[12][0-9]|3[0-6])_[a-z0-9_]+\\.md$"
        }
      },
      "additionalProperties": false
    },
    "deferredTasks": {
      "const": ["26"]
    },
    "supersededTasks": {
      "const": ["21", "22", "27", "28", "29", "30", "31"]
    },
    "verificationCommands": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task", "command"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-(0[1-9]|1[0-9]|2[0-5]|3[2-6])-[a-z0-9-]+$"
          },
          "task": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|2[0-5]|3[2-6])$"
          },
          "command": {
            "type": "string",
            "pattern": "^rtk [^\\r\\n]+$"
          }
        }
      }
    },
    "automatedAcceptanceOwners": {
      "type": "array",
      "minItems": 90,
      "maxItems": 90,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptanceId", "primaryTask", "verificationCommandIds"],
        "properties": {
          "acceptanceId": {
            "type": "string",
            "pattern": "^AC-AUTO-(00[1-9]|0[1-8][0-9]|09[0-1])$"
          },
          "primaryTask": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|2[0-5]|3[2-6])$"
          },
          "verificationCommandIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^task-(0[1-9]|1[0-9]|2[0-5]|3[2-6])-[a-z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
