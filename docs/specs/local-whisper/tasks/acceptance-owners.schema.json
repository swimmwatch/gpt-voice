{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/schemas/local-whisper-acceptance-owners-v1.json",
  "title": "Local Whisper automated acceptance ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specificationRevision", "planRevision", "taskFiles", "verificationCommands", "automatedAcceptanceOwners"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "specificationRevision": {
      "const": 17
    },
    "planRevision": {
      "const": 23
    },
    "taskFiles": {
      "type": "object",
      "minProperties": 26,
      "maxProperties": 26,
      "patternProperties": {
        "^(0[1-9]|1[0-9]|2[0-6])$": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-9]|2[0-6])_[a-z0-9_]+\\.md$"
        }
      },
      "additionalProperties": false
    },
    "verificationCommands": {
      "type": "array",
      "minItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task", "command"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-(0[1-9]|1[0-9]|2[0-6])-[a-z0-9-]+$"
          },
          "task": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|2[0-6])$"
          },
          "command": {
            "type": "string",
            "pattern": "^rtk [^\\r\\n]+$"
          }
        }
      }
    },
    "automatedAcceptanceOwners": {
      "type": "array",
      "minItems": 81,
      "maxItems": 81,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptanceId", "primaryTask", "verificationCommandIds"],
        "properties": {
          "acceptanceId": {
            "type": "string",
            "pattern": "^AC-AUTO-(00[1-9]|0[1-5][0-9]|06[0-9]|07[0-9]|08[0-2])$"
          },
          "primaryTask": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|2[0-6])$"
          },
          "verificationCommandIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^task-(0[1-9]|1[0-9]|2[0-6])-[a-z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
