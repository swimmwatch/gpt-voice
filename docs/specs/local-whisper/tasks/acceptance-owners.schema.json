{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-voice.local/schemas/local-whisper-acceptance-owners-v2.json",
  "title": "Local Whisper automated acceptance ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specificationRevision",
    "planRevision",
    "taskFiles",
    "deferredTasks",
    "verificationCommands",
    "automatedAcceptanceOwners"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "specificationRevision": {
      "const": 20
    },
    "planRevision": {
      "const": 28
    },
    "taskFiles": {
      "type": "object",
      "minProperties": 31,
      "maxProperties": 31,
      "patternProperties": {
        "^(0[1-9]|1[0-9]|2[0-9]|3[01])$": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-9]|2[0-9]|3[01])_[a-z0-9_]+\\.md$"
        }
      },
      "additionalProperties": false
    },
    "deferredTasks": {
      "const": ["26"]
    },
    "verificationCommands": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task", "command"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-(0[1-9]|1[0-9]|2[0-5]|2[7-9]|3[01])-[a-z0-9-]+$"
          },
          "task": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|2[0-5]|2[7-9]|3[01])$"
          },
          "command": {
            "type": "string",
            "pattern": "^rtk [^\\r\\n]+$"
          }
        }
      }
    },
    "automatedAcceptanceOwners": {
      "type": "array",
      "minItems": 89,
      "maxItems": 89,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptanceId", "primaryTask", "verificationCommandIds"],
        "properties": {
          "acceptanceId": {
            "type": "string",
            "pattern": "^AC-AUTO-(00[1-9]|0[1-5][0-9]|06[0-9]|07[0-9]|08[0-9]|090)$"
          },
          "primaryTask": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|2[0-5]|2[7-9]|3[01])$"
          },
          "verificationCommandIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^task-(0[1-9]|1[0-9]|2[0-5]|2[7-9]|3[01])-[a-z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
