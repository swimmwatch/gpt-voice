# Keep every tracked text file byte-stable across supported Linux and Windows
# checkouts. Binary fixtures and assets are declared explicitly below.
* text=auto eol=lf

*.bin binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary

# Native patch locks authenticate their exact reviewed bytes on every platform.
runtime/local-whisper/whisper-cpp/patches/** text eol=lf

# Native JSONL fixtures are byte-exact protocol evidence on every platform.
tests/fixtures/local-whisper/native-runtime-log/**/*.jsonl text eol=lf
