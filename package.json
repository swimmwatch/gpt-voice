  "keywords": [
    "electron",
    "chatgpt",
    "openai",
    "openai-api",
    "whisper",
    "transcription",
    "speech-to-text",
    "desktop",
    "cloakbrowser"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "commonjs",
  "build": {
    "appId": "com.swimmwatch.gptvoice",
    "productName": "GPT-Voice",
    "copyright": "Copyright (c) 2026 Dmitry Vasiliev",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/abort-controller/**/*",
      "node_modules/archiver/**/*",
      "node_modules/async/**/*",
      "node_modules/b4a/**/*",
      "node_modules/base64-js/**/*",
      "node_modules/balanced-match/**/*",
      "node_modules/bare-events/**/*",
      "node_modules/brace-expansion/**/*",
      "node_modules/buffer-crc32/**/*",
      "node_modules/buffer/**/*",
      "node_modules/compress-commons/**/*",
      "node_modules/concat-map/**/*",
      "node_modules/core-util-is/**/*",
      "node_modules/crc-32/**/*",
      "node_modules/crc32-stream/**/*",
      "node_modules/event-target-shim/**/*",
      "node_modules/events/**/*",
      "node_modules/events-universal/**/*",
      "node_modules/fast-fifo/**/*",
      "node_modules/inherits/**/*",
      "node_modules/ieee754/**/*",
      "node_modules/is-stream/**/*",
      "node_modules/isarray/**/*",
      "node_modules/lazystream/**/*",
      "node_modules/minimatch/**/*",
      "node_modules/normalize-path/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/process/**/*",
      "node_modules/process-nextick-args/**/*",
      "node_modules/readable-stream/**/*",
      "node_modules/readdir-glob/**/*",
      "node_modules/safe-buffer/**/*",
      "node_modules/streamx/**/*",
      "node_modules/string_decoder/**/*",
      "node_modules/tar-stream/**/*",
      "node_modules/text-decoder/**/*",
      "node_modules/util-deprecate/**/*",
      "node_modules/zip-stream/**/*",
      "node_modules/cloakbrowser/**/*",
      "node_modules/tar/**/*",
      "node_modules/@isaacs/fs-minipass/**/*",
      "node_modules/chownr/**/*",
      "node_modules/minipass/**/*",
      "node_modules/minizlib/**/*",
      "node_modules/mkdirp/**/*",
      "node_modules/yallist/**/*",
      "node_modules/electron-log/**/*",
      "!node_modules/bare-fs{,/**/*}",
      "!node_modules/bare-path{,/**/*}",
      "!node_modules/bare-stream{,/**/*}",
      "!node_modules/bare-url{,/**/*}",
      "!node_modules/teex{,/**/*}",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!**/{__test__,__tests__,fixture,fixtures,test,tests}/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.png",
          "icons/**/*.png",
          "tray-icon-idle.png",
          "tray-icon-paused.png",
          "tray-icon-prettifying.png",
          "tray-icon-processing.png",
          "tray-icon-recording.png",
          "prettify/codex-output.schema.json"
        ]
      },
      {
        "from": "build/generated/common/license.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": ".cache/cloakbrowser",
        "to": "cloakbrowser"
      },
      {
        "from": "build/generated/local-whisper/shared",
        "to": "local-whisper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronLanguages": [
      "en-US",
      "en-GB",
      "ru",
      "uk"
    ],
    "linux": {
      "extraResources": [
        {
          "from": "build/generated/local-whisper/native",
          "to": "local-whisper/native",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "gpt-voice",
      "category": "Utility",
      "icon": "assets/icons",
      "synopsis": "Voice transcription through GPT web sessions and OpenAI API",
      "description": "GPT-Voice records speech on your desktop and sends it through an authenticated GPT web session or OpenAI API for fast transcription without a local model or GPU.",
      "vendor": "Dmitry Vasiliev",
      "maintainer": "Dmitry Vasiliev <contact.vasiliev.dmitry@gmail.com>",
      "desktop": {
        "entry": {
          "Name": "GPT-Voice",
          "GenericName": "Voice Transcriber",
          "Comment": "Transcribe speech through GPT web sessions or OpenAI API",
          "Keywords": "voice;transcription;speech;chatgpt;openai;whisper;",
          "StartupWMClass": "gpt-voice"
        }
      }
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional",
      "fpm": [
        "build/generated/linux/com.swimmwatch.gptvoice.metainfo.xml=/usr/share/metainfo/com.swimmwatch.gptvoice.metainfo.xml",
        "build/generated/linux/debian-copyright=/usr/share/doc/gpt-voice/copyright"
      ]
    },
    "rpm": {
      "packageCategory": "Utility",
      "depends": [
        "(libXtst or libXtst6)",
        "(libuuid or libuuid1)",
        "alsa-lib",
        "at-spi2-core",
        "gtk3",
        "libXScrnSaver",
        "libnotify",
        "mesa-libgbm",
        "nss",
        "xdg-utils"
      ],
      "fpm": [
        "build/generated/linux/com.swimmwatch.gptvoice.metainfo.xml=/usr/share/metainfo/com.swimmwatch.gptvoice.metainfo.xml",
        "build/generated/common/license.txt=/usr/share/licenses/gpt-voice/LICENSE.txt"
      ]
    },
    "appImage": {
      "license": "build/generated/common/license.txt"
    },
    "win": {
      "extraResources": [
        {
          "from": "build/generated/local-whisper/native",
          "to": "local-whisper/native",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "nsis"
      ],
      "executableName": "GPT-Voice",
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true,
      "legalTrademarks": "GPT-Voice is an independent project and is not affiliated with OpenAI."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "GPT-Voice",
      "shortcutName": "GPT-Voice",
      "uninstallDisplayName": "GPT-Voice",
      "deleteAppDataOnUninstall": false,
      "license": "build/generated/windows/license.txt"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "executableName": "GPT-Voice",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "extraResources": [
        {
          "from": "build/generated/macos/PrivacyInfo.xcprivacy",
          "to": "PrivacyInfo.xcprivacy"
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "CFBundleDisplayName": "GPT-Voice",
        "NSHumanReadableCopyright": "Copyright (c) 2026 Dmitry Vasiliev",
        "NSMicrophoneUsageDescription": "GPT-Voice uses the microphone to record speech for transcription."
      }
    },
    "dmg": {
      "title": "GPT-Voice ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
